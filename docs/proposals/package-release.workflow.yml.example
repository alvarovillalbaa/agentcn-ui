# Inactive copy. The active manual-only file is retired after its owned attempt.
name: Agentcn candidate package consumers
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: agentcn-package-release-checks
  cancel-in-progress: false
jobs:
  packages:
    if: github.repository == 'alvarovillalbaa/agentcn-ui' && github.ref == 'refs/heads/main' && github.event.repository.private == false && github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: ${{ github.sha }}
      AGENTCN_PUBLIC_REPOSITORY: ${{ github.event.repository.private == false }}
    steps:
      - name: Record earliest owned job clock
        shell: bash
        run: printf 'AGENTCN_RELEASE_JOB_STARTED_MS=%s\n' "$(date +%s%3N)" >> "$GITHUB_ENV"
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          clean: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '24.22.2'
      - name: Guard, build, inspect archives and exercise fresh consumers
        shell: bash
        run: node scripts/run-package-release-checks.mjs --source-commit "$SOURCE_COMMIT"
