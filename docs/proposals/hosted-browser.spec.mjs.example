// INACTIVE: four real demo workflows, once per desktop/narrow Chromium profile.
import { test as base, expect } from '@playwright/test';
import { createHash } from 'node:crypto';

const ORIGIN = 'https://agentcn-ui.vercel.app';
const DEPLOYMENT = process.env.AGENTCN_EXPECTED_DEPLOYMENT || '';
if (!/^dpl_[A-Za-z0-9]{1,100}$/.test(DEPLOYMENT)) throw new Error('A reviewed hosted deployment identity is required.');
const DEMOS = {
  'multi-input': { title: 'Multi Input', label: 'Context tags' },
  'member-picker': { title: 'Member Picker', label: 'Review members' },
  'creatable-select': { title: 'Creatable Select', label: 'Workflow' },
  'pricing-table': { title: 'Pricing Table', label: 'Workspace plans' },
};
const TITLES = {
  'MultiInput preserves pointer and keyboard tags, validation and responsive limits': 'multi-input',
  'MemberPicker preserves hidden selections and native keyboard limits while disabled members stay unavailable': 'member-picker',
  'CreatableSelect acknowledges explicit creation and preserves existing options on duplicates': 'creatable-select',
  'PricingTable uses a native review drawer with keyboard focus and local plan acknowledgement': 'pricing-table',
};
const sha256 = value => createHash('sha256').update(value).digest('hex');
const sourcePages = JSON.parse(process.env.AGENTCN_EXPECTED_PAGES || 'null');
const allowedPages = JSON.parse(process.env.AGENTCN_ALLOWED_PAGES || 'null');
if (!Array.isArray(sourcePages) || sourcePages.length !== 4 || !Array.isArray(allowedPages) || allowedPages.length !== 32
  || new Set(allowedPages).size !== 32 || allowedPages.some(path => typeof path !== 'string' || !/^\/(?:[a-z0-9-]+\/)*$/.test(path))) throw new Error('Missing checked page manifests.');
const PAGES = new Set(allowedPages), DOCUMENTS = new Map();
for (const row of sourcePages) {
  if (!row || !Object.keys(DEMOS).some(name => row.route === `/docs/components/${name}/`) || DOCUMENTS.has(row.route)
    || !Number.isSafeInteger(row.bytes) || row.bytes < 1 || row.bytes > 2 * 1024 * 1024 || !/^[a-f0-9]{64}$/.test(row.sha256)) throw new Error('Invalid observed HTML manifest.');
  DOCUMENTS.set(row.route, row);
}
function errorText(value, maximumBytes) {
  const redacted = value.replace(/https?:\/\/[^\s"'<>]+/gi, raw => {
    try { const url = new URL(raw); return url.origin === ORIGIN ? url.origin + url.pathname : '[url]'; }
    catch { return '[url]'; }
  }).replace(/(?:data|blob):[^\s"'<>]+/gi, '[url]').replace(/[\u0000-\u001f\u007f]/g, ' ');
  let end = 0, bytes = 0;
  for (const character of redacted) {
    const size = Buffer.byteLength(character);
    if (bytes + size > maximumBytes) break;
    end += character.length; bytes += size;
  }
  return redacted.slice(0, end);
}
function publicPage(path) { return PAGES.has(path.endsWith('/') ? path : path + '/'); }
function rscPage(path) {
  if (path.endsWith('/index.txt') && PAGES.has(path.slice(0, -9))) return true;
  if (path.endsWith('.txt') && publicPage(path.slice(0, -4))) return true;
  const separator = path.lastIndexOf('/'), filename = path.slice(separator + 1);
  return filename.length <= 512 && /^__next[^/\\\s?#]*\.txt$/.test(filename) && PAGES.has(path.slice(0, separator + 1));
}
function pageQuery(url) {
  const entries = [...url.searchParams];
  return entries.length === 0 || (entries.length === 1 && entries[0][0] === '_rsc' && /^[a-zA-Z0-9_-]{1,160}$/.test(entries[0][1]));
}
function staticRead(url) {
  const entries = [...url.searchParams];
  if (url.pathname === '/icon.svg') return entries.length === 0 || (entries.length === 1 && entries[0][1] === '' && /^[a-zA-Z0-9_.-]{1,160}$/.test(entries[0][0]));
  return url.pathname.startsWith('/_next/static/') && /\.(?:js|css|woff2?|ttf)$/.test(url.pathname)
    && (entries.length === 0 || (entries.length === 1 && entries[0][0] === 'dpl' && entries[0][1] === DEPLOYMENT));
}
const test = base.extend({
  boundary: [async ({ context }, use, testInfo) => {
    const name = TITLES[testInfo.title];
    if (!name || !['desktop-chromium', 'narrow-chromium'].includes(testInfo.project.name)) throw new Error('Unexpected demo/profile.');
    const state = { schemaVersion: 1, kind: 'agentcn-hosted-browser-boundary', expectedDeployment: DEPLOYMENT,
      document: null, documentCount: 0, staticReads: 0, pageReads: 0, prefetchReads: 0,
      unexpectedRequests: 0, credentialRequests: 0, webSockets: 0,
      pageErrorCount: 0, pageErrorFingerprints: [], pageErrorDiagnostics: [] };
    const onError = event => {
      state.pageErrorCount++;
      if (state.pageErrorFingerprints.length < 8) {
        const error = event.error(), hash = sha256(error.name + '\n' + error.message);
        state.pageErrorFingerprints.push(hash);
        if (state.pageErrorDiagnostics.length < 4) state.pageErrorDiagnostics.push({ name: errorText(error.name, 64), message: errorText(error.message, 384), sha256: hash });
      }
    };
    context.on('weberror', onError);
    try {
      await context.routeWebSocket('**/*', async route => { state.webSockets++; await route.close({ code: 1008, reason: 'Outside component acceptance scope' }); });
      await context.route('**/*', async route => {
        const request = route.request(), url = new URL(request.url()), headers = await request.allHeaders();
        if (headers.cookie || headers.authorization) { state.credentialRequests++; return route.abort('blockedbyclient'); }
        if (url.origin === ORIGIN && ['GET', 'HEAD'].includes(request.method())) {
          if (staticRead(url)) { state.staticReads++; return route.continue(); }
          if (publicPage(url.pathname) && pageQuery(url)) {
            state.pageReads++;
            if (request.method() === 'HEAD' || headers.rsc || headers['next-router-prefetch'] || url.searchParams.has('_rsc')) state.prefetchReads++;
            return route.continue();
          }
          if (rscPage(url.pathname) && pageQuery(url)) { state.prefetchReads++; return route.continue(); }
        }
        state.unexpectedRequests++; await route.abort('blockedbyclient');
      });
      await use({ state, name });
    } finally {
      try {
        const body = Buffer.from(JSON.stringify(state));
        if (body.length > 8192) throw new Error('Boundary evidence exceeded eight KiB.');
        await testInfo.attach('agentcn-hosted-browser-boundary', { body, contentType: 'application/json' });
        expect(state.documentCount).toBe(1); expect(state.document?.matchesExpected).toBe(true);
        expect(state.staticReads).toBeGreaterThan(0);
        expect(state.unexpectedRequests).toBe(0); expect(state.credentialRequests).toBe(0);
        expect(state.webSockets).toBe(0); expect(state.pageErrorCount).toBe(0);
      } finally { context.off('weberror', onError); }
    }
  }, { auto: true }],
});

async function openDemo(page, boundary, name) {
  expect(boundary.name).toBe(name);
  const path = `/docs/components/${name}/`, expected = DOCUMENTS.get(path);
  const response = await page.goto(ORIGIN + path, { waitUntil: 'load' });
  if (!response) throw new Error('The hosted demo returned no document response.');
  const url = new URL(response.url()), bytes = await response.body();
  if (bytes.length > 2 * 1024 * 1024) throw new Error('Document response exceeded two MiB.');
  boundary.state.documentCount++;
  boundary.state.document = { route: url.pathname, status: response.status(), bytes: bytes.length, sha256: sha256(bytes),
    matchesExpected: bytes.length === expected.bytes && sha256(bytes) === expected.sha256 };
  expect(url.origin).toBe(ORIGIN); expect(url.pathname).toBe(path); expect(url.search).toBe('');
  expect(response.status()).toBe(200); expect(boundary.state.document.matchesExpected).toBe(true);
  await expect(page.getByRole('heading', { level: 1, name: DEMOS[name].title, exact: true })).toBeVisible();
  const notice = page.locator('.component-doc .callout p').filter({ hasText: 'The published npm 0.1.0 packages do not include this component yet.' });
  await expect(notice).toBeVisible();
  const surface = page.locator('.docs-preview').getByRole('region', { name: DEMOS[name].label, exact: true });
  await expect(surface).toBeVisible(); return surface;
}
async function layout(page, surface) {
  const geometry = await surface.evaluate(node => {
    const rect = node.getBoundingClientRect();
    return { left: rect.left, right: rect.right, scroll: node.scrollWidth, client: node.clientWidth,
      viewport: document.documentElement.clientWidth, page: document.documentElement.scrollWidth };
  });
  expect(geometry.left).toBeGreaterThanOrEqual(-1); expect(geometry.right).toBeLessThanOrEqual(geometry.viewport + 1);
  expect(geometry.scroll).toBeLessThanOrEqual(geometry.client + 1); expect(geometry.page).toBeLessThanOrEqual(geometry.viewport + 1);
}

test('MultiInput preserves pointer and keyboard tags, validation and responsive limits', async ({ page, boundary }) => {
  const surface = await openDemo(page, boundary, 'multi-input');
  const input = surface.getByLabel('New tag', { exact: true }), add = surface.getByRole('button', { name: 'Add tag', exact: true });
  await expect(surface.getByRole('list', { name: 'Selected tags' }).locator('li > span')).toHaveText(['Research', 'Documentation']);
  await add.click(); await expect(surface.getByRole('alert')).toHaveText('Enter a tag before adding it.');
  await input.fill('Research'); await input.press('Enter'); await expect(surface.getByRole('alert')).toHaveText('This exact tag is already selected.');
  await expect(surface.locator('.ac-token')).toHaveCount(2);
  await input.fill('Pointer QA'); await add.click(); await expect(surface.getByRole('button', { name: 'Remove Pointer QA', exact: true })).toBeVisible();
  await input.fill('Keyboard QA'); await input.press('Enter'); await expect(surface.getByRole('button', { name: 'Remove Keyboard QA', exact: true })).toBeVisible();
  const long = 'L'.repeat(40);
  await expect(input).toHaveAttribute('maxlength', '40'); await input.fill(''); await input.pressSequentially('L'.repeat(45));
  await expect(input).toHaveValue(long); await input.press('Enter');
  await expect(surface.locator('.ac-token')).toHaveCount(5); await expect(add).toBeDisabled();
  await input.fill('Overflow QA'); await input.press('Enter');
  await expect(surface.getByRole('alert')).toHaveText('Choose at most 5 tags. Remove one before adding another.');
  await expect(surface.locator('.ac-token')).toHaveCount(5); await layout(page, surface);
  const longToken = surface.locator('.ac-token').filter({ hasText: long });
  expect(await longToken.evaluate(node => node.scrollWidth <= node.clientWidth + 1)).toBe(true);
  await surface.getByRole('button', { name: 'Remove Pointer QA', exact: true }).click();
  await surface.getByRole('button', { name: 'Remove Keyboard QA', exact: true }).press('Enter');
  for (const value of ['Research', 'Documentation', long]) await surface.getByRole('button', { name: 'Remove ' + value, exact: true }).click();
  await expect(surface.getByText('No tags added yet.', { exact: true })).toBeVisible(); await expect(add).toBeEnabled();
});

test('MemberPicker preserves hidden selections and native keyboard limits while disabled members stay unavailable', async ({ page, boundary }) => {
  const surface = await openDemo(page, boundary, 'member-picker');
  const search = surface.getByLabel('Search members', { exact: true });
  const research = surface.getByRole('checkbox', { name: 'Research team', exact: true });
  const design = surface.getByRole('checkbox', { name: 'Design team', exact: true });
  const operations = surface.getByRole('checkbox', { name: 'Operations team', exact: true });
  const unavailable = surface.getByRole('checkbox', { name: 'Unavailable team', exact: true });
  await expect(research).toBeChecked(); await expect(unavailable).toBeDisabled(); await expect(unavailable).not.toBeChecked();
  await expect(surface.getByText('Disabled demo member', { exact: true })).toBeVisible();
  await search.fill('Design'); await expect(research).toHaveCount(0); await expect(surface.getByRole('status')).toContainText('1 / 2 selected.');
  await design.check(); await expect(surface.getByRole('status')).toContainText('2 / 2 selected.');
  await search.fill(''); await expect(research).toBeChecked(); await expect(design).toBeChecked();
  await expect(operations).toBeDisabled(); await expect(unavailable).toBeDisabled();
  await design.press('Space'); await expect(design).not.toBeChecked(); await expect(operations).toBeEnabled();
  await operations.press('Space'); await expect(operations).toBeChecked(); await expect(operations).toBeFocused();
  await expect(research).toBeChecked(); await expect(design).toBeDisabled(); await expect(unavailable).not.toBeChecked();
  await search.fill('Authored missing member'); await expect(surface.getByText('No members match your search.', { exact: true })).toBeVisible();
  await expect(surface.getByRole('status')).toContainText('2 / 2 selected.');
  await search.fill(''); await expect(research).toBeChecked(); await expect(operations).toBeChecked();
  await research.press('Space'); await expect(research).not.toBeChecked(); await expect(design).toBeEnabled();
  await expect(unavailable).toBeDisabled(); await expect(unavailable).not.toBeChecked(); await layout(page, surface);
});

test('CreatableSelect acknowledges explicit creation and preserves existing options on duplicates', async ({ page, boundary }) => {
  const surface = await openDemo(page, boundary, 'creatable-select');
  const select = surface.getByRole('combobox', { name: 'Workflow', exact: true });
  const input = surface.getByLabel('New option', { exact: true }), add = surface.getByRole('button', { name: 'Add new', exact: true });
  await expect(select).toHaveValue('research'); await select.selectOption({ label: 'Writing' }); await expect(select).toHaveValue('writing');
  await add.click(); await expect(surface.getByRole('alert')).toHaveText('Enter an option name.');
  await expect(select.locator('option')).toHaveCount(3);
  const created = 'Authored workflow';
  await input.fill(created); await add.click();
  const option = select.getByRole('option', { name: created, exact: true });
  await expect(option).toHaveCount(1); const id = await option.getAttribute('value');
  expect(id).toBeTruthy(); expect(id).not.toBe('writing'); expect(id).not.toBe('research');
  await expect(select).toHaveValue(id); await expect(select.locator('option:checked')).toHaveText(created);
  await input.fill(created); await add.click(); await expect(surface.getByRole('alert')).toHaveText('An option with this exact label already exists.');
  await expect(option).toHaveCount(1); await expect(select.locator('option')).toHaveCount(4); await expect(select).toHaveValue(id);
  await select.selectOption({ label: 'Research' }); await expect(select).toHaveValue('research');
  await expect(select.getByRole('option', { name: 'Writing', exact: true })).toHaveCount(1); await layout(page, surface);
});

test('PricingTable uses a native review drawer with keyboard focus and local plan acknowledgement', async ({ page, boundary }) => {
  const surface = await openDemo(page, boundary, 'pricing-table');
  await expect(page.getByText('Example plans. Choosing a plan changes only this preview.', { exact: true })).toBeVisible();
  const starter = surface.locator('.ac-pricing-plan').filter({ has: page.getByRole('heading', { level: 4, name: 'Starter', exact: true }) });
  const team = surface.locator('.ac-pricing-plan').filter({ has: page.getByRole('heading', { level: 4, name: 'Team', exact: true }) });
  const choose = surface.getByRole('button', { name: 'Choose Team', exact: true });
  await expect(starter).toHaveAttribute('data-current', 'true'); await expect(starter.getByRole('button', { name: 'Current plan', exact: true })).toBeDisabled();
  await layout(page, surface); await choose.click();
  const drawer = page.getByRole('dialog', { name: 'Review Team', exact: true });
  await expect(drawer).toBeVisible();
  expect(await drawer.evaluate(node => node instanceof HTMLDialogElement && node.open && node.matches(':modal'))).toBe(true);
  const close = drawer.getByRole('button', { name: 'Close review', exact: true }), confirm = drawer.getByRole('button', { name: 'Confirm Team', exact: true });
  await expect(close).toBeFocused(); await close.press('Tab'); await expect(confirm).toBeFocused();
  await confirm.press('Shift+Tab'); await expect(close).toBeFocused();
  const bounds = await drawer.boundingBox(), viewport = page.viewportSize();
  expect(bounds).not.toBeNull(); expect(bounds.x).toBeGreaterThanOrEqual(-1); expect(bounds.width).toBeLessThanOrEqual(viewport.width + 1);
  expect(bounds.height).toBeLessThanOrEqual(viewport.height + 1);
  await page.keyboard.press('Escape'); await expect(drawer).toHaveCount(0); await expect(choose).toBeFocused();
  await expect(starter).toHaveAttribute('data-current', 'true'); await expect(team).toHaveAttribute('data-current', 'false');
  await choose.click(); await expect(drawer).toBeVisible(); await drawer.getByRole('button', { name: 'Close review', exact: true }).click();
  await expect(drawer).toHaveCount(0); await expect(choose).toBeFocused(); await expect(team).toHaveAttribute('data-current', 'false');
  await choose.click(); await expect(drawer).toBeVisible(); await drawer.getByRole('button', { name: 'Confirm Team', exact: true }).click();
  await expect(drawer).toHaveCount(0); await expect(team).toHaveAttribute('data-current', 'true');
  await expect(team.getByRole('button', { name: 'Current plan', exact: true })).toBeDisabled();
  await expect(starter.getByRole('button', { name: 'Choose Starter', exact: true })).toBeEnabled(); await layout(page, surface);
});
