# INACTIVE. Root pins the published preparation and READY deployment before QA activation.
name: Temporary Agentcn UI hosted browser acceptance
on:
  push:
    branches: [qa/agentcn-hosted-20261105]
permissions:
  contents: read
concurrency:
  group: agentcn-hosted-20261105
  cancel-in-progress: false
jobs:
  browser:
    if: github.event_name == 'push' && github.repository == 'alvarovillalbaa/agentcn-ui' && github.event.repository.private == false && github.ref == 'refs/heads/qa/agentcn-hosted-20261105'
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      CI: 'true'
      SOURCE_COMMIT: PREPARATION_SHA_REPLACED_BY_ROOT
      AGENTCN_EXPECTED_DEPLOYMENT: READY_DEPLOYMENT_REPLACED_BY_ROOT
      AGENTCN_EXPECTED_PAGES: 'EXPECTED_PAGES_JSON_REPLACED_BY_ROOT'
      AGENTCN_PUBLIC_REPOSITORY: ${{ github.event.repository.private == false }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          clean: false
          fetch-depth: 1
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Run only the pinned hosted Agentcn UI packet
        shell: bash
        run: |
          set -euo pipefail
          [[ "$SOURCE_COMMIT" =~ ^[a-f0-9]{40}$ ]]
          [[ "$AGENTCN_EXPECTED_DEPLOYMENT" =~ ^dpl_[A-Za-z0-9]+$ ]]
          [[ "$(git rev-parse HEAD)" == "$SOURCE_COMMIT" ]]
          node scripts/run-hosted-browser.mjs --source-commit "$SOURCE_COMMIT"
