    "newCaseNames": [
      "MultiInput adds a trimmed token through Enter and reflects controlled values",
      "MultiInput explicit changes preserve caller state and retain a failed draft",
      "MultiInput rejects blank and existing tokens without duplicate callbacks",
      "MultiInput item limits prevent additions while permitting removal",
      "MultiInput enforces text bounds and consumes later external value changes",
      "MultiInput disabled state prevents both addition and removal",
      "MultiInput IME composition and keyCode 229 do not prematurely add a token",
      "MemberPicker filters existing names and descriptions without dropping hidden selections",
      "MemberPicker toggles only supplied member IDs and preserves consumer-owned input",
      "MemberPicker respects individual and whole-control disabled states",
      "MemberPicker selection limits still allow deselecting a current member",
      "MemberPicker empty and unmatched searches never offer invented members",
      "CreatableSelect native selection preserves IDs and recovers from a caller failure",
      "CreatableSelect explicit creation emits a label without minting or selecting an ID",
      "CreatableSelect does not create empty duplicate or over-limit labels",
      "CreatableSelect serializes pending creation and exposes failure with a retry",
      "CreatableSelect late success retains a newer unsent label",
      "CreatableSelect late failure cannot attach an error to a newer label",
      "CreatableSelect changed caller context fences an older creation acknowledgement",
      "CreatableSelect disabled and composing inputs cannot request creation",
      "PricingTable renders supplied terms without inventing a current plan or billing action",
      "PricingTable opens a labelled review with supplied details before choice intent",
      "PricingTable close and native cancel return focus without choosing",
      "PricingTable pending choices serialize double clicks and failure stays retryable",
      "PricingTable closing and reopening fences a late failed choice",
      "PricingTable committed plan or current-value changes invalidate an older review",
      "PricingTable replacing the choice handler fences old work from a newer review",
      "PricingTable disabled choices and literal supplied content do not trigger billing"
    ],
    "execution": "unexecuted",
